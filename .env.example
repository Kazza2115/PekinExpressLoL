# Clé Riot (developer.riotgames.com). Laisser vide pour le mode démo (données simulées).
RIOT_API_KEY=
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Mode démo : true = client Riot simulé (aucun appel réseau). Si vide : activé automatiquement quand RIOT_API_KEY est vide.
DEMO_MODE=

# Intervalle entre deux cycles de polling (secondes). En démo, 10 s par défaut.
POLL_INTERVAL_SECONDS=90
# Secondes entre deux vérifications « qui est en game ? » (notifications de partie). Minimum 10.
LIVE_POLL_SECONDS=30
TRACK_FLEX=false

# Mot de passe des actions d'organisateur (page /admin, tirage des duos, démarrage du challenge)
ADMIN_PASSWORD=change-me

# Base SQLite (chemin relatif au dossier du projet)
DATABASE_URL=sqlite:///./data/tracker.db

# Règles du challenge
GAMES_PER_DAY=10
# Dates par défaut du challenge (jj/mm/aaaa hh:mm, heure de Paris), tant qu'aucune n'est enregistrée
CHALLENGE_START=10/10/2026 09:00
CHALLENGE_END=12/10/2026 00:00
MAX_PLAYERS=8
TIMEZONE=Europe/Paris

# Notifications Discord (optionnel) : URL d'un webhook de salon. Vide = désactivé.
DISCORD_WEBHOOK_URL=

# URL publique du site (utilisée dans les notifications)
BASE_URL=http://localhost:8000

# Windows : PekinExpress.bat ouvre aussi le tunnel Cloudflare (Tunnel.bat) au lancement. false pour désactiver.
AUTO_TUNNEL=true

# Type de tunnel : rapide (adresse trycloudflare.com qui change à chaque lancement),
# tailscale (lien fixe gratuit en .ts.net) ou cloudflare (lien fixe sur ton domaine). Voir README, « Lien fixe ».
TUNNEL=rapide
# Mode cloudflare uniquement : jeton du tunnel (tableau de bord Cloudflare). Mets aussi BASE_URL=https://ton-domaine.
CLOUDFLARE_TUNNEL_TOKEN=

# Lien fixe gratuit avec le tunnel rapide : jeton GitHub (accès « Contents » en écriture au dépôt
# uniquement). Le site publie alors son adresse du moment sur https://kazza2115.github.io/PekinExpressLoL/
# Secret : ne le partage jamais. Vide = désactivé. Voir README, « Lien fixe avec Cloudflare ».
GITHUB_TOKEN=
